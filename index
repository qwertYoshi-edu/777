<svg style="width:0;height:0;position:absolute;" aria-hidden="true" focusable="false">
  <filter id="motion-blur" x="-20%" y="-20%" width="140%" height="140%">
    <feGaussianBlur in="SourceGraphic" stdDeviation="0, 8" />
  </filter>
</svg>

<script>
(() => {
  const $ = id => document.getElementById(id);
  const rowsInput = $('rows'), colsInput = $('cols'), rosterInput = $('roster'), emptyInput = $('emptyCount');
  const grid = $('seatGrid'), legend = $('boardLegend');
  const pinMode = $('pinMode'), fixedList = $('fixedList'), drawBtn = $('drawBtn'), drawBtnText = $('drawBtnText');
  const boardWrap = $('boardWrap'), flashOverlay = $('flashOverlay'), cutinBanner = $('cutinBanner');
  const soundToggle = $('soundToggle');
  
  let fixedEmpty = new Set();
  let currentResult = null;
  let isAnimating = false;
  let soundEnabled = true;
  let toastTimer;

  let availableTokens = []; 
  let activeReels = [];
  let columnStates = [];
  // 確定済みトークンのIDと表示値をそれぞれ記録し、再利用を禁止する。
  let usedTokenKeys = new Set();
  let usedTokenIds = new Set();

  /* ==============================================================
     1. PACHISLOT AUDIO SYNTHESIZER
  ============================================================== */
  let audioCtx = null;
  function getAudio() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  soundToggle.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    soundToggle.classList.toggle('muted', !soundEnabled);
    soundToggle.setAttribute('aria-pressed', soundEnabled ? 'true' : 'false');
    soundToggle.textContent = soundEnabled ? '🔊 筐体音量: MAX' : '🔇 筐体音量: OFF';
    if (soundEnabled) playLeverSound();
  });

  function playLeverSound() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudio(); const now = ctx.currentTime;
      const osc = ctx.createOscillator(); const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(350, now); osc.frequency.exponentialRampToValueAtTime(1800, now + 0.15);
      gain.gain.setValueAtTime(0.35, now); gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
      osc.connect(gain); gain.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.3);
      
      const oscLow = ctx.createOscillator(); const gainLow = ctx.createGain();
      oscLow.type = 'square';
      oscLow.frequency.setValueAtTime(140, now); oscLow.frequency.exponentialRampToValueAtTime(20, now + 0.35);
      gainLow.gain.setValueAtTime(0.5, now); gainLow.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
      oscLow.connect(gainLow); gainLow.connect(ctx.destination);
      oscLow.start(now); oscLow.stop(now + 0.35);
    } catch(e){}
  }

  function playBitaSound(isLast = false) {
    if (!soundEnabled) return;
    try {
      const ctx = getAudio(); const now = ctx.currentTime;
      const osc = ctx.createOscillator(); const oscGain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(isLast ? 260 : 180, now); osc.frequency.exponentialRampToValueAtTime(20, now + 0.2);
      oscGain.gain.setValueAtTime(isLast ? 1.0 : 0.8, now); oscGain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
      osc.connect(oscGain); oscGain.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.25);

      const bufferSize = ctx.sampleRate * 0.1; const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
      const noise = ctx.createBufferSource(); noise.buffer = buffer;
      const filter = ctx.createBiquadFilter(); filter.type = 'bandpass';
      filter.frequency.setValueAtTime(2200, now); filter.Q.setValueAtTime(2, now);
      const noiseGain = ctx.createGain();
      noiseGain.gain.setValueAtTime(isLast ? 0.9 : 0.6, now); noiseGain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
      noise.connect(filter); filter.connect(noiseGain); noiseGain.connect(ctx.destination);
      noise.start(now);
    } catch(e){}
  }

  function playKyuinSound() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudio(); let startTime = ctx.currentTime;
      const osc = ctx.createOscillator(); const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(750, startTime);
      osc.frequency.exponentialRampToValueAtTime(10, startTime + 0.35);
      gain.gain.setValueAtTime(0.9, startTime);
      gain.gain.exponentialRampToValueAtTime(0.01, startTime + 0.35);
      osc.connect(gain); gain.connect(ctx.destination);
      osc.start(startTime); osc.stop(startTime + 0.35);

      setTimeout(() => playFanfareChords(), 350);
    } catch(e){}
