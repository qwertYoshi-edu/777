          <div class="input-wrap"><input type="number" id="cols" min="1" max="12" value="6" aria-label="列数"><span class="suffix">列</span></div>
        </div>
      </div>

      <div class="field">
        <div class="label-row"><label for="roster">参加者 (番号・名前)</label><span class="hint">1-28、改行、カンマ区切り</span></div>
        <textarea id="roster" spellcheck="false">1-28</textarea>
        <div class="quick-tools"><button class="mini-btn" type="button" id="fillSequential">人数分オート入力</button><button class="mini-btn" type="button" id="clearRoster">全消去</button></div>
      </div>

      <div class="field">
        <div class="label-row"><label for="emptyCount">除外パネル (空席数)</label></div>
        <div class="empty-control"><input type="number" id="emptyCount" readonly aria-label="空席の数"><div class="desc">総席数と参加人数の差分から<br>自動算出されます。</div></div>
        <label class="fixed-empty-toggle"><input type="checkbox" id="pinMode"><span><strong>【固定】空席位置をピンポイント設定</strong>盤面をタップして絶対空席を確定</span></label>
        <div class="fixed-list" id="fixedList">絶対空席：なし</div>
      </div>
      
      <!-- 遊技開始用メインレバー -->
      <button class="primary-btn" id="drawBtn" type="button">
        <span id="drawBtnText">MAX BET & レバーON</span>
