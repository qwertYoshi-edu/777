  function playFanfareChords() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudio(); const now = ctx.currentTime;
      const freqs = [523.25, 659.25, 783.99, 1046.50, 1318.51, 1567.98, 2093.00];
      for(let i = 0; i < 15; i++) {
        const t = now + i * 0.05;
        const f = freqs[i % freqs.length];
        const osc = ctx.createOscillator(); const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(f, t);
        gain.gain.setValueAtTime(0.2, t); gain.gain.exponentialRampToValueAtTime(0.01, t + 0.1);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(t); osc.stop(t + 0.1);
      }
    } catch(e){}
  }

  /* ==============================================================
     2. レイアウト & ロジック
  ============================================================== */
  const clampInt = (val, min, max, def) => { const n = Number.parseInt(val, 10); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : def; };
  const rowLabel = n => { let out = ''; while (n >= 0) { out = String.fromCharCode(n % 26 + 65) + out; n = Math.floor(n / 26) - 1; } return out; };
  const seatCode = index => `${rowLabel(Math.floor(index / getCols()))}${index % getCols() + 1}`;
  const getRows = () => clampInt(rowsInput.value, 1, 12, 5);
  const getCols = () => clampInt(colsInput.value, 1, 12, 6);
  const capacity = () => getRows() * getCols();
  const getEmptyCount = () => clampInt(emptyInput.value, 0, capacity(), 0);

  function parseRoster() {
    const raw = rosterInput.value.trim();
    if (!raw) return [];
    const normalized = raw.replace(/[，、；;\r]/g, '\n').replace(/[〜～]/g, '-');
    const lines = normalized.split(/[\n,]+/).map(s => s.trim()).filter(Boolean);
    const list = [];
    for (const item of lines) {
      const tokens = item.split(/\s+/).filter(Boolean);
      for (const tok of tokens) {
        const range = tok.match(/^(\d+)\s*-\s*(\d+)$/);
        if (range) {
          let start = Number(range[1]), end = Number(range[2]);
          if (start < 1 || end < 1) throw new Error('番号は1以上で指定してください');
          const step = start <= end ? 1 : -1;
          for (let n = start; n !== end + step; n += step) list.push(String(n));
        } else {
          list.push(tok);
        }
      }
    }
    // 数字は先頭ゼロを除いて正規化し、'01' と '1' も同じ番号として扱う。
    return [...new Set(list.map(normalizeParticipantValue))];
  }

  function updateNumbers() {
    const cap = capacity();
    rowsInput.value = getRows(); colsInput.value = getCols();
    fixedEmpty = new Set([...fixedEmpty].filter(i => i >= 0 && i < cap));
    $('statSeats').innerHTML = `${cap}<span>席</span>`;
    
    try {
      const roster = parseRoster();
      const rosterLen = roster.length;
      const actualEmpty = Math.max(0, cap - rosterLen);
      $('statStudents').innerHTML = `${rosterLen}<span>人</span>`;
      $('statEmpty').innerHTML = `${actualEmpty}<span>台</span>`;
      if (emptyInput.value != actualEmpty) emptyInput.value = actualEmpty;
    } catch {
      $('statStudents').innerHTML = `—<span>人</span>`;
    }
    fixedList.textContent = fixedEmpty.size ? `絶対空席：${[...fixedEmpty].sort((a,b)=>a-b).map(i=>seatCode(i)).join('・')}` : '絶対空席：なし';
    renderPreview();
  }

  const slotColors = ['#ffd700', '#ff003c', '#00ff66', '#00e5ff', '#ff00aa', '#ffffff'];
  const slotSymbols = ['7', 'V', 'BAR', '7', 'CHANCE', 'V'];

  function updateSeatNodeDOM(node, token, isPinned = false) {
    if (isPinned) {
      node.className = `seat pinned row-${node.dataset.rowLabel}`;
      node.innerHTML = `<span class="seat-code">${node.dataset.code}</span><span class="seat-number">PIN</span><span class="seat-caption">絶対空席</span>`;
      node.removeAttribute('data-symbol');
    } else if (token.val === null) {
      node.className = `seat empty row-${node.dataset.rowLabel}`;
      node.innerHTML = `<span class="seat-code">${node.dataset.code}</span><span class="seat-number">空</span><span class="seat-caption">EMPTY</span>`;
      node.removeAttribute('data-symbol');
    } else {
      node.className = `seat filled row-${node.dataset.rowLabel}`;
      const colorIdx = node.dataset.index % 6;
      node.style.setProperty('--seat-color', slotColors[colorIdx]);
      node.dataset.symbol = slotSymbols[colorIdx];
      node.innerHTML = `<span class="seat-code">${node.dataset.code}</span><span class="seat-number">${token.val}</span><span class="seat-caption">確定！</span>`;
    }
  }

  function makeSeatNode(index, token, preview = false) {
    const btn = document.createElement('div');
    btn.dataset.index = index;
    btn.dataset.rowLabel = rowLabel(Math.floor(index / getCols())).toLowerCase();
    btn.dataset.code = seatCode(index);
    
    if (preview) {
      btn.className = `seat row-${btn.dataset.rowLabel} ${fixedEmpty.has(index) ? 'pinned' : 'empty'}`;
      btn.innerHTML = `<span class="seat-code">${btn.dataset.code}</span><span class="seat-number">${fixedEmpty.has(index) ? 'PIN' : 'WAIT'}</span><span class="seat-caption">${fixedEmpty.has(index) ? '絶対空席' : 'EMPTY'}</span>`;
      if (pinMode.checked) {
        btn.classList.add('selectable');
        btn.addEventListener('click', () => {
          if (fixedEmpty.has(index)) fixedEmpty.delete(index);
          else {
            if (fixedEmpty.size >= getEmptyCount()) { showToast(`空席数の上限(${getEmptyCount()}台)です！`); return; }
            fixedEmpty.add(index);
          }
          updateNumbers();
        });
      }
    } else {
      updateSeatNodeDOM(btn, token, fixedEmpty.has(index));
    }
    return btn;
  }

  function renderPreview() {
    $('reelControls').hidden = true;
    grid.replaceChildren();
    grid.style.gridTemplateColumns = `repeat(${getCols()}, minmax(0, 1fr))`;
    for (let i = 0; i < capacity(); i++) grid.appendChild(makeSeatNode(i, null, true));
    legend.hidden = true;
    $('liveStatus').className = 'live-status'; $('statusText').textContent = 'WAITING';
    document.querySelector('.machine-body').classList.remove('spinning-mode');
  }

  /* ==============================================================
     3. リアルタイム目押し・リール更新エンジン
  ============================================================== */
  function triggerShock(isLast = false) {
    boardWrap.classList.remove('shake-intense'); void boardWrap.offsetWidth; boardWrap.classList.add('shake-intense');
    flashOverlay.classList.add('active'); setTimeout(() => flashOverlay.classList.remove('active'), 60);
    const callouts = isLast ? ['全席確定！！', 'HYPER BONUS！！', '運命の刻完了！！', 'MAX DRIVE！！'] : ['ビタ止まり！！', 'CHANCE！！', '１確！！', '激熱！！'];
    cutinBanner.textContent = callouts[Math.floor(Math.random() * callouts.length)];
    cutinBanner.classList.add('show'); setTimeout(() => cutinBanner.classList.remove('show'), 450);
  }

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  // 番号の表記揺れを統一する。名前など数字以外の値は前後空白を除去する。
  function normalizeParticipantValue(value) {
    const text = String(value).trim();
    return /^\d+$/.test(text) ? text.replace(/^0+(?=\d)/, '') : text;
  }

  function tokenValueKey(token) {
    if (!token || token.val === null || token.val === undefined) return null;
    const value = normalizeParticipantValue(token.val);
    return /^\d+$/.test(value) ? `number:${value}` : `text:${value}`;
  }

  function getActiveRowsForColumn(column, rows, cols) {
    const activeRows = [];
    for (let r = 0; r < rows; r++) {
      if (!fixedEmpty.has(r * cols + column)) activeRows.push(r);
    }
    return activeRows;
  }

  // poolからID・表示値の両方が重複しないトークンを選ぶ。
  // nullは空席トークンなので表示値ではなくIDで区別する。
  function pickDistinctTokens(pool, count) {
    if (count <= 0) return [];
    const picked = [];
    const seenIds = new Set(usedTokenIds);
    const seenValues = new Set(usedTokenKeys);
    for (const token of shuffle([...pool])) {
      if (!token || seenIds.has(token.id)) continue;
      const key = tokenValueKey(token);
      if (key !== null && seenValues.has(key)) continue;
      seenIds.add(token.id);
      if (key !== null) seenValues.add(key);
      picked.push(token);
      if (picked.length === count) break;
    }
    return picked;
  }

  // 停止位置は必ず行数単位にそろえる。
  // これにより、絶対空席の行位置が停止後にずれない。
  function isValidReelStart(baseBand, startIndex, activeRows, pool) {
    const poolIds = new Set(pool.map(t => t.id));
    const seenIds = new Set(usedTokenIds);
    const seenValues = new Set(usedTokenKeys);
    for (const row of activeRows) {
      const token = baseBand[startIndex + row];
      if (!token || !poolIds.has(token.id) || seenIds.has(token.id)) return false;
      seenIds.add(token.id);
      const key = tokenValueKey(token);
      if (key !== null) {
        if (seenValues.has(key)) return false;
        seenValues.add(key);
      }
    }
    return true;
  }

  function collectValidReelStarts(baseBand, activeRows, pool, rows) {
    const validStarts = [];
    // 行単位のブロック開始位置のみを許可。固定空席も同じ行に保たれる。
    for (let start = 0; start + rows <= baseBand.length; start += rows) {
      if (isValidReelStart(baseBand, start, activeRows, pool)) validStarts.push(start);
    }
    return validStarts;
  }

  // レーン帯を現在の未使用候補だけで組み直す。
  // 各ブロックでは、絶対空席以外の表示値が必ず一意になる。
  function buildReelBand(pool, rows, cols, column, requestedLength) {
    const activeRows = getActiveRowsForColumn(column, rows, cols);
    const bandLength = Math.max(rows, Math.ceil(Math.max(requestedLength, rows * 3) / rows) * rows);
    const baseBand = Array.from({ length: bandLength }, (_, i) => ({
      id: `__placeholder_${column}_${i}`,
      val: null,
      placeholder: true
    }));

    for (let blockStart = 0; blockStart < bandLength; blockStart += rows) {
      const blockTokens = pickDistinctTokens(pool, activeRows.length);
      if (blockTokens.length !== activeRows.length) continue;
      activeRows.forEach((row, i) => {
        baseBand[blockStart + row] = blockTokens[i];
      });
    }

    const validStartIndices = collectValidReelStarts(baseBand, activeRows, pool, rows);
    return {
      baseBand,
      baseBandLength: bandLength,
      fullBand: baseBand.concat(baseBand.slice(0, rows)),
      validStartIndices
    };
  }

  function nearestValidStart(reel, requestedIndex) {
    const length = reel.baseBandLength;
    const candidates = reel.validStartIndices || [];
    if (!candidates.length) return null;
    let best = candidates[0];
    let bestDistance = Infinity;
    for (const candidate of candidates) {
      const directDistance = Math.abs(candidate - requestedIndex);
      const distance = Math.min(directDistance, length - directDistance);
      if (distance < bestDistance) {
        best = candidate;
        bestDistance = distance;
      }
    }
    return best;
  }

  // 実際に停止表示される行の全トークンを、確定前に再検証する。
  function getSelectableTokensAt(reel, startIndex) {
    if (startIndex === null || startIndex === undefined) return null;
    const activeRows = getActiveRowsForColumn(reel.column, reel.rows, reel.cols);
    const availableIds = new Set(availableTokens.map(t => t.id));
    const seenIds = new Set(usedTokenIds);
    const seenValues = new Set(usedTokenKeys);
    const selected = new Map();

    for (const row of activeRows) {
      const token = reel.fullBand[startIndex + row];
      if (!token || !availableIds.has(token.id) || seenIds.has(token.id)) return null;
      seenIds.add(token.id);
      const key = tokenValueKey(token);
      if (key !== null) {
        if (seenValues.has(key)) return null;
        seenValues.add(key);
      }
      selected.set(row, token);
    }
    return selected.size === activeRows.length ? selected : null;
  }

  function draw() {
    if (isAnimating) return;
    let roster;
    try { roster = parseRoster(); } catch (err) { showToast(err.message); return; }
    const cap = capacity();
    const rosterLen = roster.length;
    const actualEmpty = cap - rosterLen;

    if (actualEmpty < 0) { showToast(`遊技者オーバー！ (最大 ${cap} 人)`); return; }
    if (fixedEmpty.size > actualEmpty) { showToast(`絶対空席が多すぎます (最大 ${actualEmpty} 席)`); return; }
    if (rosterLen === 0 && actualEmpty > 0) { showToast('参加者を入力してください'); return; }

    getAudio(); playLeverSound();

    const rows = getRows(), cols = getCols();
    currentResult = { rows, cols, seats: Array(cap).fill(null) };
    usedTokenKeys = new Set();
    usedTokenIds = new Set();

    let idSeq = 0;
    // rosterはparseRosterで正規化・重複排除済み。
    availableTokens = roster.map(n => ({ id: `s_${n}`, val: n }));
    const autoBlankCount = actualEmpty - fixedEmpty.size;
    for (let i = 0; i < autoBlankCount; i++) availableTokens.push({ id: `e_${idSeq++}`, val: null });

    const bandLength = Math.ceil(Math.max(availableTokens.length, rows * 3) / rows) * rows;

    isAnimating = true;
    drawBtn.disabled = true; drawBtn.classList.add('in-spin'); drawBtnText.textContent = 'ビタ押しでSTOPせよ！';
    boardWrap.classList.add('spinning-mode');
    document.querySelector('.machine-body').classList.add('spinning-mode');
    $('liveStatus').className = 'live-status active'; $('statusText').textContent = '抽選中 RUSH';
    legend.hidden = true;

    grid.replaceChildren();
    grid.style.gridTemplateColumns = `repeat(${cols}, minmax(0, 1fr))`;
    const controls = $('reelControls'); controls.replaceChildren();
    controls.style.gridTemplateColumns = `repeat(${cols}, minmax(0, 1fr))`; controls.hidden = false;

    activeReels = [];
    columnStates = Array(cols).fill('spinning');

    for (let c = 0; c < cols; c++) {
      const viewport = document.createElement('div');
      viewport.className = 'reel-column-viewport spinning';
      const track = document.createElement('div');
      track.className = 'reel-column-track';

      const bandData = buildReelBand(availableTokens, rows, cols, c, bandLength);
      const fullBand = bandData.fullBand;
      const domNodes = [];

      fullBand.forEach((token, i) => {
        const dummyIndex = (i % rows) * cols + c;
        const node = makeSeatNode(dummyIndex, token, false);
        track.appendChild(node);
        domNodes.push(node);
      });

      viewport.appendChild(track); grid.appendChild(viewport);

      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'pachi-stop';
      btn.innerHTML = `<span>STOP ${c + 1}</span><span class="stop-tag">PUSH!</span>`;
      btn.addEventListener('click', () => bitaStopColumn(c));
      controls.appendChild(btn);

      activeReels.push({
        column: c, rows, cols, viewport, track, btn, domNodes,
        baseBandLength: bandData.baseBandLength, fullBand,
        validStartIndices: bandData.validStartIndices,
        y: 0, pitch: 0, loopHeight: 0, rafId: null, stopped: false
      });
    }

    requestAnimationFrame(() => {
      const firstSeat = activeReels[0].track.firstElementChild;
      const seatHeight = firstSeat.getBoundingClientRect().height;
      const gap = Number.parseFloat(getComputedStyle(activeReels[0].track).rowGap) || 10;
      const pitch = seatHeight + gap;
      const viewHeight = seatHeight * rows + gap * (rows - 1) + gap * 2;

      activeReels.forEach(reel => {
        reel.pitch = pitch;
        reel.loopHeight = pitch * reel.baseBandLength;
        reel.viewport.style.height = `${viewHeight}px`;
        startReelLoop(reel);
      });
    });
  }

  function startReelLoop(reel) {
    let lastTime = performance.now();
    const speed = 3.2;
    function frame(now) {
      if (reel.stopped) return;
      const dt = Math.min(30, now - lastTime);
      lastTime = now;
      reel.y = (reel.y + speed * dt) % reel.loopHeight;
      reel.track.style.transform = `translate3d(0, ${-reel.y}px, 0)`;
      reel.rafId = requestAnimationFrame(frame);
    }
    reel.rafId = requestAnimationFrame(frame);
  }

  function bitaStopColumn(c) {
    const reel = activeReels[c];
    if (!reel || reel.stopped) return;

    const requestedStartIdx = Math.round(reel.y / reel.pitch) % reel.baseBandLength;
    let startIdx = nearestValidStart(reel, requestedStartIdx);
    let selectedByRow = getSelectableTokensAt(reel, startIdx);

    // 現在の候補集合から帯を組み直して再検証。重複を許容するフォールバックは行わない。
    if (!selectedByRow) {
      const bandData = buildReelBand(
        availableTokens, reel.rows, reel.cols, reel.column, reel.baseBandLength
      );
      reel.baseBandLength = bandData.baseBandLength;
      reel.fullBand = bandData.fullBand;
      reel.validStartIndices = bandData.validStartIndices;
      reel.loopHeight = reel.pitch * reel.baseBandLength;
      reel.domNodes.forEach((node, i) => {
        updateSeatNodeDOM(node, reel.fullBand[i] || { val: null }, fixedEmpty.has(Number(node.dataset.index)));
      });
      startIdx = nearestValidStart(reel, requestedStartIdx);
      selectedByRow = getSelectableTokensAt(reel, startIdx);
    }

    if (!selectedByRow) {
      showToast('重複しない候補を確保できません。設定を確認してください');
      return;
    }

    const activeRows = getActiveRowsForColumn(c, reel.rows, reel.cols);
    if (selectedByRow.size !== activeRows.length) {
      showToast('候補数が一致しません。停止をやり直してください');
      return;
    }

    reel.stopped = true;
    cancelAnimationFrame(reel.rafId);
    const rows = reel.rows, cols = reel.cols;
    reel.y = startIdx * reel.pitch;
    reel.track.style.transform = `translate3d(0, ${-reel.y}px, 0)`;

    columnStates[c] = 'stopped';
    reel.btn.disabled = true; reel.btn.classList.add('stopped');
    reel.btn.innerHTML = `<span>LOCKED</span><span class="stop-tag">確定</span>`;
    reel.viewport.classList.remove('spinning');

    const usedIdsThisColumn = new Set();
    for (let r = 0; r < rows; r++) {
      const idx = r * cols + c;
      const node = reel.domNodes[startIdx + r];
      node.dataset.index = idx;
      node.dataset.code = seatCode(idx);
      node.dataset.rowLabel = rowLabel(Math.floor(idx / cols)).toLowerCase();

      if (fixedEmpty.has(idx)) {
        // 固定空席は対象位置から動かさず、トークンも割り当てない。
        currentResult.seats[idx] = null;
        updateSeatNodeDOM(node, { val: null }, true);
      } else {
        const token = selectedByRow.get(r);
        if (!token || usedIdsThisColumn.has(token.id)) {
          // ここに到達することはないが、重複を含む結果は確定させない。
          reel.stopped = false;
          showToast('重複する候補を検出したため停止を取り消しました');
          return;
        }
        const key = tokenValueKey(token);
        if (key !== null && usedTokenKeys.has(key)) {
          reel.stopped = false;
          showToast('確定済み番号との重複を検出したため停止を取り消しました');
          return;
        }
        currentResult.seats[idx] = token.val;
        usedIdsThisColumn.add(token.id);
        usedTokenIds.add(token.id);
        if (key !== null) usedTokenKeys.add(key);
        updateSeatNodeDOM(node, token, false);
      }
    }

    availableTokens = availableTokens.filter(token => {
      if (usedIdsThisColumn.has(token.id) || usedTokenIds.has(token.id)) return false;
      const key = tokenValueKey(token);
      return key === null || !usedTokenKeys.has(key);
    });

    reel.track.classList.add('bita-snap');
    updateUnstoppedReels();

    const stoppedCount = columnStates.filter(s => s === 'stopped').length;
    const isAllComplete = stoppedCount === cols;

    playBitaSound(isAllComplete); triggerShock(isAllComplete);
    if (isAllComplete) {
      if (!validateFinalResult()) {
        isAnimating = false;
        drawBtn.disabled = false; drawBtn.classList.remove('in-spin'); drawBtnText.textContent = '再抽選';
        $('liveStatus').className = 'live-status'; $('statusText').textContent = 'CHECK ERROR';
        showToast('最終結果に重複を検出しました。再抽選してください');
        return;
      }
      finishAllReels();
    }
  }

  function updateUnstoppedReels() {
    activeReels.forEach(reel => {
      if (reel.stopped) return;
      const bandData = buildReelBand(
        availableTokens, reel.rows, reel.cols, reel.column, reel.baseBandLength
      );
      reel.baseBandLength = bandData.baseBandLength;
      reel.fullBand = bandData.fullBand;
      reel.validStartIndices = bandData.validStartIndices;
      reel.loopHeight = reel.pitch * reel.baseBandLength;

      for (let i = 0; i < reel.fullBand.length; i++) {
        const node = reel.domNodes[i];
        if (!node) continue;
        updateSeatNodeDOM(node, reel.fullBand[i], fixedEmpty.has(Number(node.dataset.index)));
      }
    });
  }

  // 最終データと画面上の配置前提を検査。異常な結果は完成扱いにしない。
  function validateFinalResult() {
    if (!currentResult || currentResult.seats.length !== currentResult.rows * currentResult.cols) return false;
    const seenValues = new Set();
    for (let i = 0; i < currentResult.seats.length; i++) {
      const value = currentResult.seats[i];
      if (fixedEmpty.has(i) && value !== null) return false;
      if (value === null || value === undefined) continue;
      const key = tokenValueKey({ val: value });
      if (key === null || seenValues.has(key)) return false;
      seenValues.add(key);
    }
    return true;
  }

  function finishAllReels() {
    isAnimating = false;
    boardWrap.classList.remove('spinning-mode');
    document.querySelector('.machine-body').classList.remove('spinning-mode');
    drawBtn.disabled = false; drawBtn.classList.remove('in-spin'); drawBtnText.textContent = 'コンティニュー (再遊技)';
    $('liveStatus').className = 'live-status complete'; $('statusText').textContent = '全席確定 BONUS';

    playKyuinSound(); launchConfetti();
    document.querySelectorAll('.seat.filled').forEach(node => node.classList.add('rainbow-glow'));
    legend.hidden = false;
    
    const assigned = currentResult.seats.filter(x => x !== null && x !== undefined).length;
    $('resultSummary').innerHTML = `着席完了：<strong class="text-gold">${assigned}人</strong> ／ 空き台 <strong style="color:var(--cyan)">${currentResult.seats.length - assigned}台</strong>`;
    showToast('★★★ PREMIUM BONUS！全席確定！ ★★★');
  }

  /* ==============================================================
     4. パーティクル & ユーティリティ
  ============================================================== */
  function launchConfetti() {
    const layer = $('confettiLayer'); layer.replaceChildren();
    const cList = ['#00ff66','#ff003c','#ffd700','#00e5ff'];
    for (let i = 0; i < 70; i++) {
      const p = document.createElement('i'); p.className = 'confetti';
      p.style.left = `${Math.random() * 100}%`; 
      p.style.color = cList[i % cList.length];
      p.style.background = 'currentColor';
      p.style.animationDelay = `${Math.random() * 0.5}s`; 
      p.style.animationDuration = `${1.0 + Math.random() * 1.5}s`;
      layer.appendChild(p);
    }
    setTimeout(() => layer.replaceChildren(), 3000);
  }

  function showToast(msg) {
    const t = $('toast'); t.textContent = msg; t.classList.add('show');
    clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), 2800);
  }

  rowsInput.addEventListener('change', updateNumbers); colsInput.addEventListener('change', updateNumbers);
  emptyInput.addEventListener('change', updateNumbers); rosterInput.addEventListener('input', updateNumbers);
  pinMode.addEventListener('change', () => { updateNumbers(); if (pinMode.checked) showToast('盤面をタップして絶対空席を指定せよ！'); });
  drawBtn.addEventListener('click', draw);
  $('fillSequential').addEventListener('click', () => { 
    const count = Math.max(1, capacity() - fixedEmpty.size); 
    rosterInput.value = `1-${count}`; 
    updateNumbers(); 
    showToast(`1〜${count} をオートチャージ！`); 
  });
  $('clearRoster').addEventListener('click', () => { rosterInput.value = ''; updateNumbers(); });
  $('copyBtn').addEventListener('click', async () => {
    if (!currentResult) { showToast('先に遊技を開始してください！'); return; }
    let txt = `【超速回胴 確定結果】 (${currentResult.rows}行 × ${currentResult.cols}列)\n教卓側 ↑\n\n`;
    for (let r = 0; r < currentResult.rows; r++) {
      txt += currentResult.seats.slice(r * currentResult.cols, (r + 1) * currentResult.cols).map((v, c) => `${seatCode(r * currentResult.cols + c)}: ${v === null ? '空' : v}`).join('\t') + '\n';
    }
    await navigator.clipboard.writeText(txt); showToast('結果をクリップボードに退避した！');
  });
  $('printBtn').addEventListener('click', () => { if (!currentResult) { showToast('先に遊技を開始してください！'); return; } window.print(); });

  updateNumbers();
})();
</script>
</body>
</html>
